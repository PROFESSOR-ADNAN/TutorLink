{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/auth/:path*"
    },
    {
      "source": "/tutors/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/tutors/:path*"
    },
    {
      "source": "/bookings/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/bookings/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/users/:path*"
    },
    {
      "source": "/reviews/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/reviews/:path*"
    },
    {
      "source": "/payments/:path*",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/payments/:path*"
    },
    {
      "source": "/health",
      "destination": "https://tutorlink-backend-7uqu.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
