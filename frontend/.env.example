# Base URL of the backend API. In development, Vite proxies /api to
# http://localhost:5000 (see vite.config.js), so this can usually be left
# unset locally. In production, point this at your deployed API, e.g.
# https://api.tutorlink.com/api/v1
VITE_API_URL=/api/v1

# No payment-related key needed here — Chapa's checkout is a full page
# redirect handled entirely by the backend (see backend/.env.example for
# CHAPA_SECRET_KEY). Unlike Stripe, the frontend never talks to Chapa
# directly, so there's nothing equivalent to a "publishable key" to set.
