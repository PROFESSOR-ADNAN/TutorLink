# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Your backend's own public URL — used to build Chapa's callback_url.
# In local dev with the Stripe/Chapa-style webhook flow this needs to be
# reachable from the internet (see the payments section below).
BACKEND_URL=http://localhost:5000
# Your frontend's URL — used for CORS and for building redirect URLs
# (e.g. Chapa's return_url after checkout).
CLIENT_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tutorlink

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── Payments — Chapa ────────────────────────────────────
# From your Chapa dashboard under Settings > API Keys.
CHAPA_SECRET_KEY=

# A secret YOU choose yourself and register in the Chapa dashboard's
# webhook settings (unlike Stripe, Chapa doesn't generate this for you) —
# used to verify that a webhook request genuinely came from Chapa.
CHAPA_WEBHOOK_SECRET=

# Percentage of each paid booking TutorLink keeps as commission. 0.18 = 18%.
PLATFORM_COMMISSION_RATE=0.18

# ── Image uploads — Cloudinary ──────────────────────────
# From your Cloudinary dashboard homepage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TutorLink <no-reply@tutorlink.com>

# ── Note on Docker ──────────────────────────────────────
# If you're running this via docker-compose, editing this file alone does
# NOT update an already-running container — env_file is only read when a
# container is created. After changing any value here, recreate the
# backend container to pick it up:
#   docker-compose up -d --build backend
